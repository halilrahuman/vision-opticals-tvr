# Vision Opticals Environment Configuration

# Server Port (Render/Railway/Heroku sets this automatically)
PORT=5000

# Secret key for JWT admin authentication (use a long random string in production)
JWT_SECRET=vision_opticals_prod_secret_change_this_to_a_random_string_2026

# Environment mode
NODE_ENV=production

# (Optional) Custom paths for SQLite database and uploads if using cloud mounted disks
# DB_PATH=/var/data/vision_opticals.db
# UPLOAD_DIR=/var/data/uploads
